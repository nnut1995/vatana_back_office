# --- Database ---
# Local development: a MongoDB running on the default port.
MONGODB_URI="mongodb://localhost:27017"
# For production (Vercel), use your MongoDB Atlas SRV connection string instead:
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="vatana"

# --- Auth (Auth.js / NextAuth) ---
# Required. Generate a strong value with:  openssl rand -base64 32
AUTH_SECRET="change-me"

# --- S3 (product photos) ---
# IAM user with s3:PutObject / s3:GetObject / s3:DeleteObject on the bucket.
# The bucket can stay private: images are streamed through /api/images.
S3_ACCESS_KEY="AKIA..."
S3_SECRET_ACCESS_KEY="change-me"
S3_REGION="ap-southeast-1"
S3_BUCKET="vatana-backoffice"
